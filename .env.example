# ---- App ----
NEXT_PUBLIC_URL="http://localhost:3000"

# ---- Database (MongoDB connection string used by Prisma) ----
DATABASE_URL="mongodb+srv://user:pass@cluster/dbname?retryWrites=true&w=majority"

# ---- Auth (NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="UhilAcademy <noreply@mail.uhilacademy.com>"

# ---- File uploads ----
# Active path is local disk via /api/media/upload (writes to ./media/).
# NOTE: local disk is ephemeral on Vercel — for production migrate to
# Vercel Blob or S3. See plan in repo.

# ---- SMS / OTP (AWS Pinpoint or chosen provider) ----
NEXT_PUBLIC_SMS_KEY=""

# ---- Upload service (UploadThing) ----
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ---- Optional: distributed rate limiting (recommended for prod) ----
# Provision Upstash Redis (Vercel Marketplace) and install:
#   npm i @upstash/ratelimit @upstash/redis
# Then set:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
